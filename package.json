{
  "name": "koishi-plugin-chatluna-studio",
  "description": "在 Koishi 控制台中查看 ChatLuna 真实模型请求并编辑预设",
  "version": "1.0.1",
  "type": "commonjs",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#client/*": "./client/*"
  },
  "files": [
    "lib",
    "dist"
  ],
  "homepage": "https://github.com/Sor85/koishi-plugin-chatluna-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sor85/koishi-plugin-chatluna-studio.git"
  },
  "license": "MIT",
  "scripts": {
    "clean": "shx rm -rf lib dist",
    "build": "yarn clean && yarn build:server && yarn build:client",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:server": "yarn build:types && tsup src/index.ts --format cjs --out-dir lib --clean false",
    "watch:server": "node scripts/watch-server.mjs",
    "build:client": "yarn build:css && vite build",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn test && yarn typecheck && yarn build"
  },
  "keywords": [
    "chatbot",
    "chatluna",
    "koishi",
    "onebot",
    "preset"
  ],
  "koishi": {
    "browser": true,
    "public": [
      "dist"
    ],
    "description": {
      "zh": "查看 ChatLuna 真实模型请求并编辑预设"
    },
    "service": {
      "required": [
        "console"
      ],
      "optional": [
        "database"
      ]
    }
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "koishi": "^4.18.10",
    "koishi-plugin-chatluna": "*"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@koishijs/console": "^5.30.11",
    "animejs": "4.5.0",
    "codemirror": "^6.0.2",
    "fast-xml-parser": "^5.3.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/core": "^4.18.10",
    "@koishijs/plugin-console": "^5.30.11",
    "@tabler/icons-vue": "^3.45.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "koishi": "^4.18.10",
    "postcss": "8.5.19",
    "reka-ui": "^2.10.1",
    "shx": "^0.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.0.0",
    "typescript": "5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "yarn@4.15.0"
}
