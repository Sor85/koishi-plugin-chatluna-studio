{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "#client/*": [
        "./client/*"
      ],
      "@koishijs/client": [
        "./client/koishi-client-shim.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "client/**/*.ts",
    "client/**/*.vue",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "dist"
  ]
}
